  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Application Health & HTTP Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP Request Throughput (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"authory-service\"}[1m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "HTTP Response Time Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"authory-service\"}[1m])) by (le))",
          "legendFormat": "p50 (Median)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"authory-service\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"authory-service\"}[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "JVM & Infrastructure Resources",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "id": 3,
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "jvm_memory_used_bytes{application=\"authory-service\", area=\"heap\"}",
          "legendFormat": "Used: {{id}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "jvm_memory_max_bytes{application=\"authory-service\", area=\"heap\"}",
          "legendFormat": "Max Heap"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "id": 4,
      "title": "JVM Threads & Loom Virtual Threads",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "jvm_threads_live_threads{application=\"authory-service\"}",
          "legendFormat": "Live Platform Threads"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "jvm_threads_daemon_threads{application=\"authory-service\"}",
          "legendFormat": "Daemon Threads"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2 },
          "unit": "none"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "title": "HikariCP Database Connections",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "hikaricp_connections_active{application=\"authory-service\"}",
          "legendFormat": "Active Connections"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "hikaricp_connections_idle{application=\"authory-service\"}",
          "legendFormat": "Idle Connections"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "hikaricp_connections_pending{application=\"authory-service\"}",
          "legendFormat": "Pending (Waiting) Threads"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Centralized Application Logs (Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "id": 6,
      "title": "Live Application Log Stream (Click TraceID to jump to Jaeger)",
      "type": "logs",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"authory-service\"}"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
